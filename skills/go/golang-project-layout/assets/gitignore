# Go .gitignore template — copy to the project root as `.gitignore`.
# (Stored without the leading dot so it does not act as ignore rules inside this skill.)

# Build output
/bin/
/dist/

# Test binaries and coverage
*.test
*.out
coverage.*
*.coverprofile
/profile.cov

# Profiling artifacts
*.prof
*.pprof

# Go workspace file (commit it only if the repo is intentionally a multi-module workspace)
go.work
go.work.sum

# Local environment and secrets
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
