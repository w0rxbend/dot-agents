# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=sk-...

# Anthropic API Key (if using Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Note: Only one API key is required
# The server will auto-detect which provider to use

# Optional: override model names (check the provider's current model list)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5
