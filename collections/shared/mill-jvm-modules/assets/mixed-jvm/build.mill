//| mill-version: 1.1.10
//| mill-jvm-version: system
package build

import mill.*
import mill.javalib.{JavaModule, DepSyntax}
import mill.scalalib.ScalaModule
import mill.kotlinlib.KotlinModule

trait JvmConventions extends JavaModule {
  def jvmVersion = "temurin:21.0.8"
  def javacOptions = Seq("--release", "21")
}

object api extends JvmConventions

object kotlinImpl extends KotlinModule, JvmConventions {
  def kotlinVersion = "2.2.20"
  def kotlincOptions = Seq("-jvm-target", "21")
  def moduleDeps = Seq(api)
}

object scalaService extends ScalaModule, JvmConventions {
  def scalaVersion = "3.8.2"
  def scalacOptions = Seq("-release", "21", "-deprecation", "-feature")
  def moduleDeps = Seq(api, kotlinImpl)

  object test extends ScalaTests {
    def mvnDeps = Seq(mvn"com.lihaoyi::utest:0.9.1")
    def testFramework = "utest.runner.Framework"
  }
}

object app extends JvmConventions {
  def moduleDeps = Seq(scalaService)
  def mainClass = Some("example.Main")
}

object unrelated extends JvmConventions
