# flowrite — PRODUCTION environment template.
# Copy to .env.production and set ANTHROPIC_API_KEY — an empty or placeholder
# value causes a 401 authentication_error at run start.
# Select with: flue run <resource> --env .env.production --input '{...}'
# NOTE: --env loads ONLY this file; it does NOT also load .env. Put the real key
# here, or export ANTHROPIC_API_KEY in the shell (shell values win over --env).
ANTHROPIC_API_KEY=

# Capable models, higher reasoning effort.
WRITER_MODEL=anthropic/claude-sonnet-4-6
WRITER_EFFORT=high

RESEARCHER_MODEL=anthropic/claude-sonnet-4-6
RESEARCHER_EFFORT=medium

EXAMPLES_MODEL=anthropic/claude-sonnet-4-6
EXAMPLES_EFFORT=medium

INTEGRATOR_MODEL=anthropic/claude-sonnet-4-6
INTEGRATOR_EFFORT=medium

# REPO_PATH is supplied per run (workflow projectPath / agent id); leave unset here.
